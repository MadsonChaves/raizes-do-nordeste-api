    {
      "name": "T01 - Login com sucesso",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "\r\npm.test(\"T01 - Login retorna status 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"T01 - Login retorna token\", function () {\r\n    const resposta = pm.response.json();\r\n\r\n    pm.expect(resposta).to.have.property(\"access_token\");\r\n    pm.expect(resposta.token_type).to.eql(\"bearer\");\r\n});\r\n"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"email\": \"paulo.teste@example.com\",\r\n  \"senha\": \"SenhaForte123!\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://127.0.0.1:8000/usuarios/login",
          "protocol": "http",
          "host": [
